#!/bin/bash
#
# Post-merge hook (MBM-341): REPORT ONLY.
#
# It says what the merge changed and what to run next. It never stops the
# service, kills processes, installs packages or builds: a merge on a dev
# machine (or anywhere) must not change what is running. Deploying is done
# on purpose: a release (npm run release) installed with
# deploy/server/install-release.ps1 (docs/runbooks/manual-deployment.md).
#

CHANGED_FILES=$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null)
[ -z "$CHANGED_FILES" ] && exit 0

has() { echo "$CHANGED_FILES" | grep --quiet "$1"; }

echo ""
echo "== Post-merge: what changed"
has "package.json"       && echo "  package.json        -> dependencies may have changed"
has "prisma/migrations/" && echo "  prisma/migrations/  -> new database migrations"
has "prisma/schema.prisma" && echo "  prisma/schema.prisma -> the Prisma client must be regenerated"
has "windows-service/"   && echo "  windows-service/    -> the service files changed"
has "^src/"              && echo "  src/                -> application code"
echo ""
echo "  Nothing was stopped, installed or built."
echo "  Dev machine:  npm install, then npm run db:deploy, then npm run dev"
echo "  A server:     npm run release, then docs/runbooks/manual-deployment.md"
echo ""
exit 0
