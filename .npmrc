# legacy-peer-deps avoids npm 7+'s strict peer-dependency resolution failing
# on this project's own tree (some deps have narrow/outdated peer ranges).
# Note: this file alone does NOT fix the printer package's own postinstall
# step, which spawns a separate `npm install` with its own working directory
# and so doesn't inherit this project-level config — see
# ADMIN-INSTALLATION-GUIDE.md's Prerequisites section for the one-time
# `npm config set legacy-peer-deps true` needed for that.
legacy-peer-deps=true
