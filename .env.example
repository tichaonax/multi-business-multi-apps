# Multi-Business Management Platform - Environment Configuration
# Copy this file to .env.local and update the values for your environment

# ================================
# DATABASE CONFIGURATION
# ================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/multi_business_db"

# ================================
# NEXTAUTH CONFIGURATION
# ================================
# Base URL for the application (update for production deployment)
# NOTE: NEXTAUTH_URL is commented out to allow flexible host access
# This enables login from both localhost and IP addresses (e.g., 192.168.0.112:8080)
# Uncomment and set to specific URL only if you need strict URL validation
# NEXTAUTH_URL="http://localhost:8080"

# Secret key for NextAuth (GENERATE A NEW ONE FOR PRODUCTION!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# ================================
# APPLICATION CONFIGURATION
# ================================
# Environment mode (development, production)
NODE_ENV="production"

# Application name
APP_NAME="Multi-Business Management Platform"

# Admin email for notifications
ADMIN_EMAIL="admin@yourdomain.com"

# Port for the application to run on
PORT=8080

# Encryption key for sensitive data (R710 passwords, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="generate-a-64-char-hex-string"

# ================================
# LOGGING CONFIGURATION
# ================================
# Application logging level (error, warn, info, debug)
LOG_LEVEL="info"

# Log directory (absolute path or relative to project root)
LOG_DIRECTORY="logs"

# Maximum log file size
LOG_MAX_FILE_SIZE="10MB"

# Maximum number of log files to keep
LOG_MAX_FILES=10

# Enable console logging (set false for production service)
LOG_CONSOLE=false

# ================================
# APPLICATION FEATURES
# ================================
# Maximum file upload size
MAX_FILE_SIZE="10mb"

# Allowed file types for uploads
ALLOWED_FILE_TYPES="image/*,application/pdf"

# Session configuration
SESSION_MAX_AGE=30 # days

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900 # 15 minutes in seconds

# ================================
# SECURITY SETTINGS
# ================================
# Enable HTTPS redirect (set to true in production with SSL)
FORCE_HTTPS=false

# CORS origins (comma-separated list)
# Include localhost and common IP address ranges for development
CORS_ORIGINS="http://localhost:8080,http://127.0.0.1:8080,http://192.168.0.0/16:8080,http://10.0.0.0/8:8080"

# Content Security Policy (uncomment for production)
# CSP_ENABLED=true

# ================================
# EMAIL CONFIGURATION (Optional)
# ================================
# Email for notifications
EMAIL_FROM="noreply@yourdomain.com"

# Email server (SMTP)
# EMAIL_SERVER="smtp://user:password@smtp.example.com:587"

# Email service provider (optional)
# EMAIL_PROVIDER="smtp"
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT=587
# EMAIL_USER="your-email@domain.com"
# EMAIL_PASSWORD="your-app-password"

# ================================
# DATABASE SCHEMA VERSION
# ================================
# Track schema version for migrations
DB_SCHEMA_VERSION="1.0.0"

# ================================
# THEME CONFIGURATION
# ================================
# Default theme (light, dark, system)
DEFAULT_THEME="system"

# Enable theme storage in database
THEME_STORAGE_ENABLED=true

# ================================
# AUDIT CONFIGURATION
# ================================
# Track IP addresses in audit logs
AUDIT_IP_TRACKING=true

# Track user agents in audit logs
AUDIT_USER_AGENT_TRACKING=true

# ================================
# DEVELOPMENT/SEED API (Optional)
# ================================
# Seed API key for headless scripts (development/testing only)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEED_API_KEY="change-this-to-a-secure-value-for-development"

# Base URL for seed scripts
SEED_API_BASE_URL="http://localhost:8080"

# ================================
# BACKUP CONFIGURATION (Optional)
# ================================
# Automatic backup settings
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE="0 2 * * *" # Daily at 2 AM
# BACKUP_RETENTION_DAYS=30

# ================================
# EXTERNAL SERVICES (Optional)
# ================================
# SMS service configuration (for 2FA)
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID="your-account-sid"
# TWILIO_AUTH_TOKEN="your-auth-token"

# ================================
# MONITORING & ANALYTICS (Optional)
# ================================
# Application monitoring
# SENTRY_DSN="your-sentry-dsn"
# NEW_RELIC_LICENSE_KEY="your-newrelic-key"

# Google Analytics
# GA_TRACKING_ID="G-XXXXXXXXXX"

# ================================
# DEVELOPMENT SETTINGS
# ================================
# Enable debug mode (development only)
DEBUG=false

# Prisma Studio port (development only)
PRISMA_STUDIO_PORT=5555

# ================================
# PERFORMANCE LOGGING (Production)
# ================================
# Set to 'true' only when debugging - keeps these OFF for performance
VERBOSE_BACKUP_LOGGING=false
VERBOSE_RESTORE_LOGGING=false

# Increase Node.js heap size to prevent OOM crashes (4GB)
NODE_OPTIONS="--max-old-space-size=4096"

# ================================
# QZ TRAY PRINTING (Optional — add after running: npm run qz:generate-cert)
# ================================
# QZ_PRIVATE_KEY=<base64 value from generate-qz-cert output>
# QZ_CERTIFICATE=<base64 value from generate-qz-cert output>

# ================================
# PRODUCTION DEPLOYMENT EXAMPLES
# ================================

# Example for Vercel deployment:
# DATABASE_URL="postgresql://username:password@host.cloud.provider.com:5432/database"
# NEXTAUTH_URL="https://your-app.vercel.app"
# NEXTAUTH_SECRET="generated-secret-key"

# Example for Heroku deployment:
# DATABASE_URL will be provided automatically by Heroku Postgres addon
# NEXTAUTH_URL="https://your-app.herokuapp.com"
# NEXTAUTH_SECRET="generated-secret-key"

# Example for Docker deployment:
# DATABASE_URL="postgresql://postgres:password@db:5432/business_platform"
# NEXTAUTH_URL="http://localhost:8080"
# NEXTAUTH_SECRET="generated-secret-key"

# ================================
# SECURITY NOTES
# ================================
# 1. Never commit your .env.local file to version control
# 2. Use strong, unique passwords for database
# 3. Generate a secure NEXTAUTH_SECRET for production
# 4. Update NEXTAUTH_URL to match your production domain (currently commented out for flexible access)
# 5. Enable HTTPS in production environments
# 6. Configure proper CORS origins for production
# 7. Use environment-specific configuration for each deployment
# 8. Change SEED_API_KEY to a secure value for development
# 9. NEXTAUTH_URL is commented out to enable cross-origin authentication from IP addresses
