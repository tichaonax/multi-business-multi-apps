{
  "name": "multi-business-pos-electron",
  "version": "1.0.10",
  "description": "Electron wrapper for Multi-Business POS with automatic dual-monitor support",
  "main": "main.js",
  "author": "Multi-Business POS",
  "scripts": {
    "start": "electron .",
    "start:restaurant": "cross-env POS_TYPE=restaurant electron .",
    "start:grocery": "cross-env POS_TYPE=grocery electron .",
    "start:hardware": "cross-env POS_TYPE=hardware electron .",
    "start:clothing": "cross-env POS_TYPE=clothing electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build:win": "node scripts/stop-running-app.js && electron-builder --win",
    "build:mac": "node scripts/stop-running-app.js && electron-builder --mac",
    "build:linux": "node scripts/stop-running-app.js && electron-builder --linux",
    "rebuild": "echo serialport uses pre-built binaries — no rebuild needed"
  },
  "dependencies": {
    "electron-store": "^7.0.3",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.multibusiness.pos",
    "productName": "Multi-Business POS",
    "directories": {
      "output": "../../multi-business-electron-dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "scale-service.js",
      "server-registry.js",
      "connection-test.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "perMachine": true,
      "oneClick": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  }
}
